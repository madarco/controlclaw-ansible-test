#!/bin/bash
# Re-run ansible-pull on this box. Takes NO arguments, on purpose: the caller (the vm-agent, over
# a firewall-signed request the person confirmed with a code) gets to say "update", never "update
# from here". What gets pulled is decided by /etc/controlclaw/update.conf, which is root-owned and
# was written at provisioning.
#
# Detached by design. The role restarts the agent on whichever box this is (controlclaw-agent on an
# agent box, controlclaw-mitm-agent on the org firewall), so a run that was a child of the agent
# would kill itself half way through. The agent calls this via `systemd-run --unit=cc-reprovision`;
# progress goes to a state file so it survives that restart and the agent can report it afterwards.
#
# On the firewall the restart is not the expensive part: the whole run is an org-wide outage,
# because the org's agents reach the internet, DNS and the permission bridge only through this box.
set -uo pipefail

CONF=/etc/controlclaw/update.conf
STATE=/opt/controlclaw/state/update.json
LOG=/var/log/ansible-pull.log
KEYS=/opt/controlclaw/keys
# Not 0 or 1: a machine reading this wants "at least a day", and an exact 24h boundary would make
# a commit flip from refused to accepted mid-run.
MIN_AGE_HOURS=24

# The state file is what the console shows. Written at every step, world-readable (it holds no
# secret: a phase, an exit code and a task name).
say() {
  local phase="$1" detail="${2:-}"
  printf '{"phase":%s,"detail":%s,"ref":%s,"at":%s,"reboot":%s}\n' \
    "$(json "$phase")" "$(json "$detail")" "$(json "${REF:-}")" "$(json "$(date -u +%FT%TZ)")" "${REBOOT:-false}" \
    > "$STATE".tmp && mv "$STATE".tmp "$STATE"
  logger -t cc-reprovision "$phase${detail:+: $detail}"
}

# Minimal JSON string escaping — enough for the phases and error lines we emit.
json() { printf '%s' "$1" | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read()))'; }

die() { say failed "$1"; exit 1; }

# May an automatic update reboot this box, as far as its disk goes?
#
# An automatic update reboots the box when a package asks for it. A box whose encrypted disk has no
# partner bound yet (a new box's first minutes: controlclaw docs/features/disk-encryption.md, "A new
# agent pairs its disk") would come back locked, with only the owner's recovery key to open it, and
# nobody asked for that reboot. So it is put off: the next maintenance run finishes it, and the
# console's health check says "Restart waiting" meanwhile.
#
# Yes for a box with no encrypted disk, and for one with a partner (`cc-secure list` prints one line
# per partner). Also yes for a firewall that is not supposed to have one: its partners are the
# organization's agents, so a firewall with no agent has none by design, and putting its reboot off
# would put it off for ever. The list it was last given is in the container's state folder.
disk_has_partner() {
  [ -f "${CC_SECURE_IMG:-/var/lib/controlclaw/secure.img}" ] || return 0
  [ -n "$("${CC_SECURE:-/usr/local/bin/cc-secure}" list 2>/dev/null)" ] && return 0
  if [ "${ROLE:-openclaw}" = mitm ]; then
    local given="${CC_SECURE_MOUNT:-/opt/controlclaw/secure}/state/tang-partners.json"
    [ -r "$given" ] && [ "$(tr -d '[:space:]' < "$given")" = "[]" ] && return 0
  fi
  return 1
}

[ -r "$CONF" ] || { logger -t cc-reprovision "no $CONF; refusing"; exit 1; }

# An encrypted box whose container is not mounted must not be re-provisioned, and this check is FIRST
# because the damage is silent.
#
# /opt/controlclaw/keys lives inside the container. On a locked box that path is an empty directory on
# the plain root, so every read_key below returns nothing and every existence guard in the role misses
# — and the play would cheerfully regenerate box_key and vm_private_key.pem on the UNENCRYPTED disk.
# The box would lose the identity every agent in the org has pinned, its .enc stores (and the
# payload_box copies the control plane holds) would become unopenable, and a fresh plaintext box key
# would be sitting on the one disk this feature exists to protect — then hidden under the bind mount
# the next time a partner opened the container. Nothing about that is visible in the output.
#
# $STATE is inside the container too, so say() cannot report this. logger is the only channel left.
if [ -f /var/lib/controlclaw/secure.img ] && ! mountpoint -q /opt/controlclaw/secure; then
  logger -t cc-reprovision "this box's disk is locked; refusing to re-provision (it would regenerate the box's identity on the plain disk)"
  echo "cc-reprovision: this box's disk is locked. Open it first (the console offers this, or npx @controlclaw/recover unlock)." >&2
  exit 3
fi
# shellcheck disable=SC1090
. "$CONF"

[ -n "${ANSIBLE_REPO:-}" ] || die "no repo pinned on this box"
# Agent boxes, the org firewall and the org brain all update in place. The blind L4 proxy does not:
# it is shared across orgs and has no consent path of its own.
ROLE="${BOX_ROLE:-openclaw}"
case "$ROLE" in
  openclaw | mitm | gbrain) ;;
  *) die "box role $ROLE does not update in place" ;;
esac

mkdir -p "$(dirname "$STATE")"
say resolving
if [ "${CC_UPDATE_MODE:-}" = auto ]; then
  [[ "${CC_UPDATE_DEADLINE:-}" =~ ^[0-9]{1,10}$ ]] || die "missing automatic update deadline"
  [ "$(date +%s)" -lt "$CC_UPDATE_DEADLINE" ] || die "automatic update window closed"
fi

# --- which commit -----------------------------------------------------------------------------
# Unless explicitly relaxed, take the newest commit on the pinned branch that is at least
# MIN_AGE_HOURS old, rather than whatever the branch points at right now. A malicious commit then
# has to survive a day of public review before any running box will execute it.
#
# curl rather than node: once this box is confined to the org proxy, everything but the control
# plane is TLS-intercepted, and node ignores the OS trust store (curl and git do not).
# An empty branch means cloud-init passed no -C and cloned the repo's default. Keep it empty
# rather than guessing "main": GitHub's commits API uses the repo's default when `sha` is omitted,
# so the box resolves commits on the branch it actually booted from.
# Dev mirrors have no commits API. Manual updates retain their branch behavior; automatic
# updates resolve the same age requirement from the mirror's Git history below.
case "$ANSIBLE_REPO" in
  https://github.com/*) FROM_GITHUB=true ;;
  *) FROM_GITHUB=false ;;
esac

if [ "${CC_UPDATE_MODE:-}" = auto ] && [ "$FROM_GITHUB" = false ]; then
  # Dev mirrors have no GitHub API. Read the actual branch history and still enforce 24 hours.
  history=$(mktemp -d) || die "cannot create history checkout"
  git clone --quiet --no-checkout "$ANSIBLE_REPO" "$history" || die "cannot read update history"
  REF=$(git -C "$history" rev-list -1 --before="${MIN_AGE_HOURS} hours ago" "origin/${ANSIBLE_BRANCH:-main}")
  rm -rf "$history"
  [ -n "$REF" ] || die "no update commit is old enough"
elif [ "${CC_UPDATE_MODE:-}" != auto ] && { [ "${ALLOW_UNVERIFIED:-false}" = "true" ] || [ "$FROM_GITHUB" = "false" ]; }; then
  REF="${ANSIBLE_BRANCH:-HEAD}"
  say resolving "unverified mode: tracking $REF"
else
  slug=$(printf '%s' "$ANSIBLE_REPO" | sed -E 's#^https://github\.com/##; s#\.git$##')
  case "$slug" in
    */*) ;;
    *) die "cannot read an owner/repo out of $ANSIBLE_REPO" ;;
  esac
  until=$(date -u -d "-${MIN_AGE_HOURS} hours" +%FT%TZ 2>/dev/null) || die "cannot compute the cutoff"
  api="https://api.github.com/repos/${slug}/commits?until=${until}&per_page=1${ANSIBLE_BRANCH:+&sha=$ANSIBLE_BRANCH}"
  REF=$(curl -fsSL --max-time 30 -H 'Accept: application/vnd.github+json' "$api" \
        | python3 -c 'import json,sys; c=json.load(sys.stdin); print(c[0]["sha"] if c else "")') \
    || die "could not reach GitHub to find a commit at least ${MIN_AGE_HOURS}h old"
  # Fail closed. No commit old enough, or no answer, means no update — never fall back to HEAD.
  [ -n "$REF" ] || die "no commit on ${ANSIBLE_BRANCH:-the default branch} is at least ${MIN_AGE_HOURS}h old yet"
  say resolving "pinned to ${REF:0:12}"
fi

# --- what the box already knows about itself --------------------------------------------------
# Rebuilt from disk, never accepted from the caller. Several of these are load-bearing:
#
#   agent box    without vm_hostname the role stops and disables Caddy (its only inbound path),
#                and without proxy_ip it re-opens 80/443 to the whole internet.
#   firewall box without org_id, controlclaw_url and saas_public_key mitmbox.yml refuses to run
#                at all — writing them empty is what bricks the box.
#
# vm_hostname is required on an agent only. A firewall built before webhook ingress has none and
# runs no Caddy, so demanding one there would make its update fail on the first check; one that has
# a name must keep it, or caddy.yml stops Caddy on the update and the firewall's webhook and Open
# routes go dark. It is read the same way as a brain's.
read_key() { [ -r "$KEYS/$1" ] && tr -d '\n' < "$KEYS/$1"; }
# A PEM goes back with its line breaks, re-folded: the role writes these straight back to the keys
# dir, and OpenSSL cannot read a PEM that is all on one line. read_key used to flatten them, which
# made an agent refuse its own firewall's CA after every update (T-88, real box 2026-09-30), and a
# box updated then still holds the flat copy, so passing the file through unchanged is not enough.
read_pem() {
  [ -r "$KEYS/$1" ] || return 0
  python3 -c '
import re, sys, textwrap
s = open(sys.argv[1]).read()
m = re.search(r"-----BEGIN ([A-Z0-9 ]+)-----(.*?)-----END \1-----", s, re.S)
if not m:
    sys.stdout.write(s.strip())
else:
    body = "\n".join(textwrap.wrap(re.sub(r"\s+", "", m.group(2)), 64))
    sys.stdout.write("-----BEGIN %s-----\n%s\n-----END %s-----" % (m.group(1), body, m.group(1)))
' "$KEYS/$1"
}

VM_ID=$(read_key vm_id)
[ -n "$VM_ID" ] || die "this box has no vm_id on disk"

VM_HOSTNAME=""
if [ "$ROLE" = openclaw ]; then
  VM_HOSTNAME=$(read_key vm_hostname)
  [ -n "$VM_HOSTNAME" ] || die "this box has no vm_hostname on disk; refusing (it would disable Caddy)"
elif [ "$ROLE" = gbrain ] || [ "$ROLE" = mitm ]; then
  # A brain built before brains had a public name has none, and that is not an error: it has no
  # Caddy to disable. One that has a name must keep it, so it is read the same way.
  VM_HOSTNAME=$(read_key vm_hostname)
  # A firewall provisioned before the role wrote that key still has its name in the Caddyfile the
  # role rendered for it: the first site block. Taken only when it looks like a hostname.
  if [ -z "$VM_HOSTNAME" ] && [ "$ROLE" = mitm ] && [ -r /etc/caddy/Caddyfile ]; then
    VM_HOSTNAME=$(grep -m1 -E '^[a-z0-9]([a-z0-9.-]*[a-z0-9])? \{$' /etc/caddy/Caddyfile | cut -d' ' -f1 || true)
  fi
fi

# The firewall's identity comes from the pin first and the keys dir second. Both are root-written
# at provisioning; the second is there so a box that lost /etc/controlclaw can still be re-run.
ORG_ID="${ORG_ID:-$(read_key org_id)}"
CONTROLCLAW_URL="${CONTROLCLAW_URL:-$(read_key controlclaw_url)}"

# NOTE: vm_private_key is deliberately never rebuilt. A secured box generated its own keypair and
# the control plane does not have it; passing one would overwrite the box's identity and every
# signed call would start failing. The bootstrap token is likewise single-use and already spent.
# On the firewall the same goes for the CA and the box key: gen-ca.sh and box-key.ts both have
# existence guards, so a re-run cannot regenerate what every agent in the org has pinned.
vars=$(BOX_ROLE="$ROLE" VM_ID="$VM_ID" VM_HOSTNAME="$VM_HOSTNAME" PROXY_IP="${PROXY_IP:-}" \
  ANSIBLE_REPO="$ANSIBLE_REPO" ANSIBLE_BRANCH="${ANSIBLE_BRANCH:-main}" ALLOW_UNVERIFIED="${ALLOW_UNVERIFIED:-false}" \
  SSH_DEBUG="${SSH_DEBUG:-false}" \
  DISK_ENCRYPTION="${DISK_ENCRYPTION:-false}" LUKS_RECOVERY_PUBKEY="${LUKS_RECOVERY_PUBKEY:-}" \
  SAAS_PUB="$(read_pem saas_public_key.pem)" \
  CONFIG_URL="$(read_key config_api_url)" READY_URL="$(read_key ready_api_url)" \
  REGISTER_URL="$(read_key register_api_url)" \
  MITM_IP="$(read_key mitm_box_private_ip)" MITM_PUB="$(read_pem mitm_pinned_pubkey.pem)" \
  ORG_ID="$ORG_ID" CONTROLCLAW_URL="$CONTROLCLAW_URL" \
  MITM_PRIVATE_SUBNET="${MITM_PRIVATE_SUBNET:-}" MITM_PUBLIC_IFACE="${MITM_PUBLIC_IFACE:-}" \
  python3 -c '
import json, os
role = os.environ["BOX_ROLE"]
v = {"vm_id": os.environ["VM_ID"], "box_role": role}
if role == "openclaw" or (role in ("gbrain", "mitm") and os.environ["VM_HOSTNAME"]):
    v["vm_hostname"] = os.environ["VM_HOSTNAME"]
# Hand the pin straight back, so self-update.yml runs on a re-run and rewrites update.conf and
# cc-reprovision itself. Without this a box keeps whatever updater it was created with, and a fix
# to the updater would need a rebuild -- exactly the problem this whole thing exists to solve.
# These come from the root-owned conf we just read, never from the caller, so nothing new is
# trusted here.
for key, env in (("ansible_repo_url", "ANSIBLE_REPO"), ("ansible_branch", "ANSIBLE_BRANCH"),
                 ("update_allow_unverified", "ALLOW_UNVERIFIED")):
    if os.environ.get(env):
        v[key] = os.environ[env]
# ssh_debug is in `shared` and always non-empty ("false" when the pin has nothing), because here the
# absent case must NOT fall through to the role default: falling through is what would take SSH away
# from a dev box halfway through its life. A box pinned before SSH_DEBUG existed reads as false,
# which is the safe direction and matches what the role would have done anyway.
# disk_encryption is in `shared` and always non-empty, for the same reason ssh_debug is: falling
# through to the role default (false) on an encrypted box would make the play skip disk-encryption.yml
# entirely, which skips the assert that stops the rest of the run writing keys to the plain disk. A box
# pinned before this existed reads as false, which is correct — it has no container.
shared = (("saas_public_key", "SAAS_PUB"), ("ready_api_url", "READY_URL"),
          ("register_api_url", "REGISTER_URL"), ("ssh_debug", "SSH_DEBUG"),
          ("disk_encryption", "DISK_ENCRYPTION"), ("luks_recovery_pubkey", "LUKS_RECOVERY_PUBKEY"))
agent = (("proxy_ip", "PROXY_IP"), ("config_api_url", "CONFIG_URL"),
         ("mitm_box_private_ip", "MITM_IP"), ("mitm_vm_public_key", "MITM_PUB"))
mitm = (("org_id", "ORG_ID"), ("controlclaw_url", "CONTROLCLAW_URL"),
        ("mitm_private_subnet", "MITM_PRIVATE_SUBNET"), ("mitm_public_iface", "MITM_PUBLIC_IFACE"))
# An empty value omits the key rather than passing "", so the role falls back to its own default
# instead of overwriting a working setting with nothing.
for key, env in shared + (mitm if role == "mitm" else agent):
    if os.environ.get(env):
        v[key] = os.environ[env]
print(json.dumps(v))')

# What the console shows for a failed run: the last task of THIS run, read from byte $2 of the log.
# Secrets never reach the log: the extra-vars we pass hold no token, and ansible redacts no_log tasks.
#
# No task at all means ansible-pull failed before the playbook started, while fetching the repo. It
# used to read the whole log, which starts with the box's first provisioning, and so reported
# "at: Provisioning complete" for a fetch that never happened (T-updfail). Say what git said instead.
failure_detail() {
  local log="$1" start="$2" rc="$3" task reason
  task=$(tail -c +"$((start + 1))" "$log" 2>/dev/null | grep -a '^TASK \[' | tail -1 | sed -E 's/^TASK \[(.*)\].*/\1/')
  if [ -n "$task" ]; then
    printf 'ansible-pull exited %s at: %s' "$rc" "$task"
    return
  fi
  reason=$(tail -c +"$((start + 1))" "$log" 2>/dev/null | python3 -c '
import re, sys
text = sys.stdin.read()
m = re.search(r"\"msg\": \"((?:[^\"\\]|\\.)*)\"", text)
line = m.group(1).encode().decode("unicode_escape", "replace") if m else ""
if not line:
    errs = [l for l in text.splitlines() if l.startswith("ERROR!") or "FAILED!" in l or l.startswith("fatal:")]
    line = errs[-1] if errs else ""
line = " ".join(line.split())
print(line[:240])
')
  printf 'could not fetch the update (ansible-pull exited %s before the playbook started)%s' "$rc" "${reason:+: $reason}"
}

# --- run ---------------------------------------------------------------------------------------
say installing "fetching collections"
ansible-galaxy collection install community.docker community.general ansible.posix \
  >> "$LOG" 2>&1 || say installing "collections already present"

# --full for anything but the production repo, matching what cloud-init did on the first boot:
# ansible-pull shallow-clones by default, and a branch served as plain files over a tunnel speaks
# git's dumb HTTP, which refuses `--depth 1` outright.
FULL=""
[ "$ANSIBLE_REPO" = "https://github.com/madarco/controlclaw-ansible.git" ] || FULL="--full"

if [ "${CC_UPDATE_MODE:-}" = auto ]; then
  [ "$(date +%s)" -lt "$CC_UPDATE_DEADLINE" ] || die "automatic update window closed before installation"
fi
say running "ansible-pull ${REF:0:12}"
# Where this run starts in the log. The log is appended to and begins with the box's first
# provisioning, so a failure must be read from here on (see failure_detail).
START=$(stat -c %s "$LOG" 2>/dev/null || echo 0)
# Saved for the Firewall Logs page (files/cc-fw-logs run), which shows this run and not the ones
# before it. World-readable like the state file: a byte offset.
echo "$START" > "$(dirname "$STATE")/update-log-start.tmp" && mv "$(dirname "$STATE")/update-log-start.tmp" "$(dirname "$STATE")/update-log-start"
ansible-pull $FULL -U "$ANSIBLE_REPO" -C "$REF" playbook.yml -e "$vars" >> "$LOG" 2>&1
rc=$?

if [ "$rc" -eq 0 ]; then
  # Package installation is allowed to finish safely if it overruns. Never initiate a late
  # restart or reboot. The next maintenance run will finish the pending reboot.
  if [ "${CC_UPDATE_MODE:-}" = auto ] && [ "$(date +%s)" -lt "$CC_UPDATE_DEADLINE" ]; then
    needrestart -r a >> "$LOG" 2>&1 || true
    if [ -f /var/run/reboot-required ] && ! disk_has_partner; then
      say done "updated to ${REF:0:12}; not rebooting yet: this box's disk is still being paired"
    elif [ -f /var/run/reboot-required ] && [ "$(date +%s)" -lt "$CC_UPDATE_DEADLINE" ]; then
      REBOOT=true say done "updated to ${REF:0:12}; rebooting"
      systemctl reboot || die "could not reboot"
    else
      say done "updated to ${REF:0:12}"
    fi
  else
    say done "updated to ${REF:0:12}"
  fi
else
  say failed "$(failure_detail "$LOG" "$START" "$rc")"
fi
exit "$rc"
