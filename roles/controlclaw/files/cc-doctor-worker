#!/usr/bin/python3
"""Runs without privilege inside the session unit; tmux and CLI share its cgroup."""
import json, os, re, shlex, socket as sockets, subprocess, sys, threading, time
from pathlib import Path
sid=sys.argv[1]
if not re.fullmatch(r'[a-zA-Z0-9_-]{8,80}',sid): sys.exit(1)
work=Path('/run/ccdoctor')/sid
os.environ['SHELL']='/bin/bash'
socket=str(work/'tmux.sock')
CHECK_SOCKS=Path('/run/ccdoctor-sock')/sid
CHECK_MODEL_PORT=7802
if len(sys.argv)>2 and sys.argv[2]=='forward':
    # A Final check has a network namespace of its own. Claude Code needs its model at an http
    # address, so this relays 127.0.0.1:7802 in here to the mitm-agent's bridge socket, byte for byte.
    def pump(a,b):
        try:
            while True:
                chunk=a.recv(65536)
                if not chunk: break
                b.sendall(chunk)
        except OSError: pass
        finally:
            for s in (a,b):
                try: s.shutdown(sockets.SHUT_RDWR)
                except OSError: pass
    server=sockets.socket(sockets.AF_INET,sockets.SOCK_STREAM)
    server.setsockopt(sockets.SOL_SOCKET,sockets.SO_REUSEADDR,1)
    server.bind(('127.0.0.1',CHECK_MODEL_PORT)); server.listen(16)
    while True:
        client,_=server.accept()
        try:
            upstream=sockets.socket(sockets.AF_UNIX,sockets.SOCK_STREAM); upstream.connect(str(CHECK_SOCKS/'model.sock'))
        except OSError:
            client.close(); continue
        threading.Thread(target=pump,args=(client,upstream),daemon=True).start()
        threading.Thread(target=pump,args=(upstream,client),daemon=True).start()
def confined(env):
    """Whether a Final check is as shut in as it has to be. Checked from inside, before the model runs."""
    def reaches(host,port):
        try:
            sockets.create_connection((host,port),timeout=2).close(); return True
        except OSError: return False
    if any(reaches(h,p) for h,p in [('1.1.1.1',443),('8.8.8.8',53),('127.0.0.1',22),('127.0.0.1',2019),('127.0.0.1',3100),('127.0.0.1',8080)]): return 'network'
    if any(k in env for k in ('ANTHROPIC_API_KEY','OPENAI_API_KEY','AI_GATEWAY_API_KEY')) or re.match(r'(sk-|vck_|eyJ)',env.get('ANTHROPIC_AUTH_TOKEN','')): return 'key'
    if any(Path(p).exists() for p in ('/opt/controlclaw','/etc/shadow','/etc/caddy','/var/lib','/var/log')) or [p.name for p in Path('/run/ccdoctor').iterdir()]!=[sid]: return 'files'
    # What is left of the folders a firewall keeps things in: nothing but this session's own.
    def listed(path):
        try: return sorted(p.name for p in Path(path).iterdir())
        except PermissionError: return []
        except OSError: return ['?']
    if not set(listed('/run'))<={'ccdoctor','ccdoctor-sock','systemd'} or listed('/run/ccdoctor-sock')!=[sid] or listed('/home') or listed('/root') or listed('/dev/shm') or listed('/opt'): return 'files'
    for attempt in range(40):
        if reaches('127.0.0.1',CHECK_MODEL_PORT): return None
        time.sleep(.1)
    return 'bridge'
if len(sys.argv)>2 and sys.argv[2]=='cli':
    data=json.loads((work/'request.json').read_text())
    env={'PATH':'/usr/local/bin:/usr/bin:/bin','HOME':str(work),'TERM':'xterm-256color',
      'DISABLE_AUTOUPDATER':'1','CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC':'1',
      'DISABLE_TELEMETRY':'1','DO_NOT_TRACK':'1','NO_UPDATE_NOTIFIER':'1',
      'PI_OFFLINE':'1','PI_SKIP_VERSION_CHECK':'1','PI_TELEMETRY':'0',
      'CODEX_HOME':str(work/'.codex'),'PI_CODING_AGENT_DIR':str(work/'.pi/agent'),**data['env']}
    cli,mode=data['cli'],data['mode']
    model=data.get('model')
    resume=data.get('resumeId')
    prompt=data.get('problem','')
    config=work/'.codex'
    config.mkdir(exist_ok=True)
    (config/'config.toml').write_text('check_for_update = false\n[analytics]\nenabled = false\n')
    check=data.get('target')=='check'
    if check:
        # No built-in tool at all (no shell, no file read): the one tool is cc-tplcheck, over MCP.
        # Anything else the model asks for is refused without a question.
        env.update({'CC_TPLCHECK_SOCK':str(CHECK_SOCKS/'tools.sock'),'ANTHROPIC_SMALL_FAST_MODEL':model,'ANTHROPIC_DEFAULT_HAIKU_MODEL':model,
          'CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS':'1'})
        (work/'mcp.json').write_text(json.dumps({'mcpServers':{'tplcheck':{'command':'/usr/local/bin/cc-tplcheck','args':['--mcp'],
          'env':{'CC_TPLCHECK_SOCK':env['CC_TPLCHECK_SOCK'],'CC_TPLCHECK_TOKEN':env['CC_TPLCHECK_TOKEN']}}}}))
        # No settings file of any kind, no skills or slash commands, and a bound on the turns.
        args=['/usr/local/bin/claude','-p','--output-format','stream-json','--verbose','--tools','','--strict-mcp-config',
          '--mcp-config',str(work/'mcp.json'),'--allowedTools','mcp__tplcheck__run','--permission-mode','dontAsk',
          '--setting-sources','','--disable-slash-commands','--max-turns','60','--model',model,'--',prompt]
    elif cli=='claude':
        args=['/usr/local/bin/claude','--dangerously-skip-permissions']
        if mode=='chat': args += ['-p','--output-format','stream-json','--verbose']
        if resume: args += ['--resume',resume]
        if model: args += ['--model',model]
        if prompt: args += ['--',prompt]
    elif cli=='codex':
        args=['/usr/local/bin/codex']
        if mode=='chat': args += ['exec','--json','--skip-git-repo-check','--dangerously-bypass-approvals-and-sandbox']
        else: args += ['--dangerously-bypass-approvals-and-sandbox']
        if model: args += ['--model',model]
        if data.get('provider') in ('openai','openai_codex') or env.get('OPENAI_BASE_URL'):
            base_url='https://chatgpt.com/backend-api/codex' if data.get('provider')=='openai_codex' else env.get('OPENAI_BASE_URL','https://api.openai.com/v1')
            args += ['-c','model_provider="doctor"','-c','model_providers.doctor.name="Doctor"',
              '-c','model_providers.doctor.base_url='+json.dumps(base_url),
              '-c','model_providers.doctor.env_key="OPENAI_API_KEY"','-c','model_providers.doctor.wire_api="responses"',
              '-c','model_providers.doctor.requires_openai_auth=false',
              '-c','model_providers.doctor.supports_websockets=false']
            if data.get('provider')=='openai_codex':
                # Access-only custom-provider auth has no login/refresh state to rotate.
                args += ['-c','model_providers.doctor.env_http_headers={"ChatGPT-Account-Id"="CC_DOCTOR_OPENAI_ACCOUNT_ID"}']
        if resume: args += ['resume',resume]
        if prompt: args += ['--',prompt]
    else:
        args=['/usr/local/bin/pi']
        provider=data.get('provider','anthropic')
        if provider=='openai_codex':
            config=work/'.pi/agent'
            config.mkdir(parents=True,exist_ok=True)
            # api_key resolves the env value and skips Pi's OAuth refresh path entirely.
            (config/'auth.json').write_text(json.dumps({'openai-codex':{'type':'api_key','key':'OPENAI_API_KEY'}}))
            # Subscription models come from the account catalog and may be newer
            # than pinned Pi's built-in catalog. Register the selected native API.
            (config/'models.json').write_text(json.dumps({'providers':{'openai-codex':{
              'baseUrl':'https://chatgpt.com/backend-api/codex',
              'api':'openai-codex-responses','apiKey':'OPENAI_API_KEY',
              'models':[{'id':model,'name':model,'reasoning':True,
                'contextWindow':128000,'maxTokens':8192}]}}}))
            args += ['--provider','openai-codex']
        elif provider=='gateway':
            config=work/'.pi/agent'
            config.mkdir(parents=True,exist_ok=True)
            (config/'models.json').write_text(json.dumps({'providers':{'doctor':{
              'baseUrl':env.get('OPENAI_BASE_URL','https://ai-gateway.vercel.sh/v1'),
              'api':'openai-completions','apiKey':'OPENAI_API_KEY',
              'models':[{'id':model,'name':model,'contextWindow':128000,'maxTokens':8192}]}}}))
            args += ['--provider','doctor']
        else: args += ['--provider',provider]
        if mode=='chat': args += ['--mode','json','-p']
        args += ['--session',str(work/'pi-session.jsonl')]
        if model: args += ['--model',model]
        # Pi has no -- terminator. A leading newline keeps untrusted text positional,
        # including prompts starting with '-' or '@'.
        if prompt: args += ['\n'+prompt]
    try:
        if check:
            # Fail closed: a check that can reach anything it should not is not started.
            why=confined(env)
            with (work/'output.jsonl').open('w') as out: out.write(json.dumps({'type':'cc_unconfined','check':why} if why else {'type':'cc_confined'})+'\n')
            if why:
                (work/'exit-code').write_text('3'); sys.exit(3)
            with (work/'output.jsonl').open('a') as out:
                result=subprocess.run(args,env=env,cwd=work,stdout=out,stderr=subprocess.STDOUT,stdin=subprocess.DEVNULL)
        elif mode=='chat':
            with (work/'output.jsonl').open('w') as out:
                result=subprocess.run(args,env=env,cwd=work,stdout=out,stderr=subprocess.STDOUT,stdin=subprocess.DEVNULL)
        else: result=subprocess.run(args,env=env,cwd=work)
        (work/'exit-code').write_text(str(result.returncode))
    finally:
        for name in ('key','request.json','mcp.json','.codex/auth.json','.pi/agent/auth.json'):
            (work/name).unlink(missing_ok=True)
    sys.exit(result.returncode)
(work/'exit-code').unlink(missing_ok=True)
(work/'output.jsonl').write_text('')
try:
    if json.loads((work/'request.json').read_text()).get('target')=='check':
        subprocess.Popen(['/usr/local/lib/cc-doctor-worker',sid,'forward'],stdin=subprocess.DEVNULL,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
except (OSError,ValueError): pass
command=shlex.join(['/usr/local/lib/cc-doctor-worker',sid,'cli'])
subprocess.run(['/usr/bin/tmux','-S',socket,'new-session','-d','-s','doctor-'+sid,'-x','120','-y','35',command],check=True)
offset=0
while subprocess.run(['/usr/bin/tmux','-S',socket,'has-session','-t','doctor-'+sid],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL).returncode==0:
    with (work/'output.jsonl').open() as out:
        out.seek(offset); chunk=out.read(); offset=out.tell()
        if chunk: sys.stdout.write(chunk); sys.stdout.flush()
    time.sleep(.15)
with (work/'output.jsonl').open() as out:
    out.seek(offset);sys.stdout.write(out.read());sys.stdout.flush()
try: sys.exit(int((work/'exit-code').read_text()))
except FileNotFoundError: sys.exit(1)
