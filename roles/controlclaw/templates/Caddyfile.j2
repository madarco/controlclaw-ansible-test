{# The console's origin, so the live-browser page can be framed there and nowhere else. Derived
   from the config API URL the control plane already gave this box (and that cc-reprovision
   replays from disk), rather than a new provisioning variable that a self-update would lose.
   Unset on a box provisioned without a callback URL: then 'self' alone, and the embed simply
   does not frame. -#}
{% set console_origin = ((config_api_url | urlsplit('scheme')) ~ '://' ~ (config_api_url | urlsplit('netloc'))) if (config_api_url is defined and config_api_url) else '' -%}
# Managed by Ansible (roles/controlclaw/templates/Caddyfile.j2). Do not edit on the box.
{
    email {{ caddy_acme_email }}
    # Issuers are explicit and tried in this order: Let's Encrypt, then ZeroSSL. Every box still
    # gets a certificate of its own for its own name, with its own key. The second issuer exists
    # because Let's Encrypt allows 50 new certificates per registered domain per week, and on
    # 2026-09-29 test boxes on the production domain used that up: every new box after it had no
    # certificate at all. ZeroSSL's ACME endpoint gets its account binding from the email above.
    cert_issuer acme https://acme-v02.api.letsencrypt.org/directory
    cert_issuer acme https://acme.zerossl.com/v2/DV90
}

{{ vm_hostname }}{% if cc_handle_alias | default('') and cc_handle_alias != vm_hostname %}, {{ cc_handle_alias }}{% endif %} {
    # Control plane -> vm-agent (bearer JWT checked by the vm-agent itself)
    handle /__cc/agent/* {
        uri strip_prefix /__cc/agent
        reverse_proxy 127.0.0.1:3100 {
            # /logs/stream is SSE: forward every write as it happens.
            flush_interval -1
        }
    }

    # A box whose encrypted disk has not been opened. Separate from /__cc/agent/* on purpose: the
    # vm-agent is not running then (it waits on cc-secure.service, whose keys are inside the
    # container), so there is nothing on 3100 to answer. cc-secure-daemon is on 3101 and is the only
    # thing up.
    #
    # Unauthenticated here, and the daemon does not check a bearer either. /disk/status returns a boot
    # id, a public key, a signature over them and a blob that is ciphertext to everyone but the owner;
    # /disk/unlock takes a passphrase sealed to this boot's key, which only a holder of the
    # organization's recovery key can produce — so the ciphertext IS the proof, and a JWT in front of
    # it would only add a dependency on the control plane being honest, which is the one thing this
    # path exists not to need. See docs/plans/disk-encryption.md §5.1.
    handle /__cc/disk/* {
        uri strip_prefix /__cc/disk
        reverse_proxy 127.0.0.1:{{ luks_locked_port | default(3101) }}
    }

    # The live browser. noVNC and the VNC server behind it are loopback-only; this is the one way
    # in, and it is gated on a ControlClaw view session.
    #
    # vnc_lite.html, not vnc.html: vnc.html persists every resolved setting into localStorage,
    # which is partitioned or blocked inside a cross-site iframe, so one failed load leaves a
    # sticky bad host/path behind. vnc_lite has no settings and always auto-connects.
    #
    # `path` has NO leading slash. noVNC 1.3.0 (Ubuntu 24.04) builds the WebSocket URL absolutely
    # from the origin root, so a leading slash would point the socket at /__cc/novnc/websockify
    # AFTER the prefix strip and miss. Assets load relatively and survive the strip; the socket
    # does not. noVNC 1.6.0 changed this — revisit if the base image moves.
    @novnc_bare path /__cc/novnc
    redir @novnc_bare /__cc/novnc/vnc_lite.html?path=__cc/novnc/websockify&scale=1 302

    handle /__cc/novnc/* {
        header {
            # Removed, not overridden: the vm-agent stamps X-Frame-Options: DENY on every HTML
            # response, and a browser-level blocked frame beats any CSP we set here.
            -X-Frame-Options
            Content-Security-Policy "frame-ancestors 'self'{% if console_origin %} {{ console_origin }}{% endif %}"
        }
        uri strip_prefix /__cc/novnc
        # Same reason as the catch-all below: the vm-agent registers no 'upgrade' listener, so a
        # forwarded Connection/Upgrade makes Node destroy the socket and Caddy answer 502.
        forward_auth 127.0.0.1:3100 {
            uri /__cc/verify-view
            header_up -Connection
            header_up -Upgrade
        }
        reverse_proxy 127.0.0.1:{{ browser_novnc_port }}
    }

    # ControlClaw login shim (login page, session exchange, logout, the live-browser bootstrap).
    # /__cc/novnc/* wins over this by matcher specificity, not by file order.
    handle /__cc/* {
        reverse_proxy 127.0.0.1:3100
    }

    # Everything else is OpenClaw, gated by the ControlClaw session cookie. On 401 the
    # vm-agent's "open this agent from your console" page is relayed to the browser.
    # The upgrade headers are stripped for the auth call: the check must answer 2xx, never 101.
    #
    # /__cc/verify ALSO checks the Origin, and it can only do that with the headers this call
    # carries (controlclaw T-68). Every agent box and the console share `controlclaw.com`, so the
    # session cookie's SameSite=Lax stops another *site* and nothing between two boxes: without
    # that check a page on box A could open `wss://B/` in the browser of somebody signed in to B
    # and drive B's agent. forward_auth copies the request's headers, which is what puts `Origin`,
    # `Sec-Fetch-*` and `X-Forwarded-Method` in front of the check. DO NOT add `header_up -Origin`,
    # `-Sec-Fetch-Site` or `-X-Forwarded-Method` here: the check would go on answering 200 and the
    # protection would be gone with nothing to show for it.
    handle {
        # The agent's own UI is never embedded by anyone, including another box. `'self'`, not
        # `'none'`: OpenClaw may frame its own pages, and blocking that would break the UI to no
        # end. Each header is set only when the upstream did not send one (`?`), so a CSP OpenClaw
        # sets for its own reasons is left exactly as it is — X-Frame-Options then still carries
        # the whole rule, which every browser honours.
        #
        # TWO directives, not one block with two `?` fields. A `?` compiles to a response matcher
        # that requires the field to be absent, and one block gets ONE matcher for all of them: if
        # OpenClaw sends a CSP, a combined block would skip X-Frame-Options as well and this
        # response would go out with neither. Verified against caddy:2-alpine, both ways round.
        header ?X-Frame-Options "SAMEORIGIN"
        header ?Content-Security-Policy "frame-ancestors 'self'"
        forward_auth 127.0.0.1:3100 {
            uri /__cc/verify
            header_up -Connection
            header_up -Upgrade
        }
        reverse_proxy 127.0.0.1:{{ openclaw_gateway_port }} {
            # Pool handle Origin rewrite (installed at claim).
{% if cc_handle_alias | default('') and cc_handle_alias != vm_hostname %}
            # forward_auth above checked the browser Origin against this box's two fixed names.
            # Keep OpenClaw's pre-warmed neutral origin; adding a handle needs no gateway restart.
            header_up Origin https://{{ vm_hostname }}
{% endif %}
        }
    }
}

# The OpenClaw widget sandbox (mcp.apps.sandboxOrigin, set in tasks/openclaw.yml). Widget HTML runs
# in an iframe on this host so that it never shares the dashboard's origin; OpenClaw refuses a sandbox
# origin equal to the dashboard's. Its listener is loopback-only on the gateway port + 1. This host
# serves exactly what that listener serves, and is signed in like the dashboard
# (controlclaw docs/security-design.md, "The widget sandbox"):
#   - the shell (/mcp-app-sandbox) only after the vm-agent's sandbox check (forward_auth). Without
#     the sandbox cookie, the dashboard's iframe is sent once through a one-time ticket minted on the
#     dashboard's own host; any other request is 403 and the shell is not served;
#   - the two renderer bundles, public: they are loaded by the widget's inner frame, whose origin is
#     opaque, so no cookie of ours could ever go with them. They are OpenClaw's static library code,
#     the same on every box;
#   - the ticket exchange, which sets this host's own __Host- cookie;
#   - 404 for everything else.
# frame-ancestors is added as a SECOND policy, not by rewriting OpenClaw's (`frame-ancestors http:
# https:`): browsers enforce every policy they get, so this one holds whatever OpenClaw sends. The
# handle a claim adds is appended here by cc-pool-local.cjs, as for the main site above.
sandbox.{{ vm_hostname }} {
    @renderer {
        method GET HEAD
        path /__openclaw__/a2ui/a2ui.bundle.js /__openclaw__/a2ui/a2ui-v0.9.bundle.js
    }
    handle @renderer {
        reverse_proxy 127.0.0.1:{{ openclaw_sandbox_port }} {
            header_up -Cookie
            header_up -Authorization
            header_down -Set-Cookie
        }
    }

    handle /__cc/sandbox/exchange {
        reverse_proxy 127.0.0.1:3100
    }

    @shell {
        method GET HEAD
        path /mcp-app-sandbox
    }
    handle @shell {
        forward_auth 127.0.0.1:3100 {
            uri /__cc/sandbox/verify
            header_up -Connection
            header_up -Upgrade
        }
        reverse_proxy 127.0.0.1:{{ openclaw_sandbox_port }} {
            header_up -Cookie
            header_up -Authorization
            header_down -Set-Cookie
            # OpenClaw marks a versioned shell immutable for a year; it is checked on every load instead.
            header_down Cache-Control "no-store"
            header_down +Content-Security-Policy "frame-ancestors https://{{ vm_hostname }}{% if cc_handle_alias | default('') and cc_handle_alias != vm_hostname %} https://{{ cc_handle_alias }}{% endif %}"
        }
    }

    handle {
        respond 404
    }
}
