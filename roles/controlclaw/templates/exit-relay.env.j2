# Managed by Ansible (roles/controlclaw/tasks/exit-relay.yml). 0600, root-owned: it holds
# ControlClaw's Apify proxy password and both shared secrets.
EXIT_RELAY_HOST=0.0.0.0
EXIT_RELAY_PORT={{ exit_relay_port | default(8443) }}
EXIT_RELAY_TLS_CERT={{ exit_relay_cert_live_dir }}/fullchain.pem
EXIT_RELAY_TLS_KEY={{ exit_relay_cert_live_dir }}/privkey.pem
EXIT_RELAY_HEALTH_HOST=127.0.0.1
EXIT_RELAY_HEALTH_PORT=8080

EXIT_RELAY_TOKEN_SECRET={{ exit_relay_token_secret }}
EXIT_RELAY_METERING_SECRET={{ exit_relay_metering_secret }}
EXIT_RELAY_CONTROL_PLANE_URL={{ exit_relay_control_plane }}
EXIT_RELAY_ID={{ exit_relay_id | default('relay-1') }}

EXIT_RELAY_UPSTREAM_HOST={{ exit_relay_upstream_host | default('proxy.apify.com') }}
EXIT_RELAY_UPSTREAM_PORT={{ exit_relay_upstream_port | default(8000) }}
EXIT_RELAY_UPSTREAM_GROUPS={{ exit_relay_upstream_groups | default('RESIDENTIAL') }}
EXIT_RELAY_UPSTREAM_PASSWORD={{ exit_relay_upstream_pass }}
